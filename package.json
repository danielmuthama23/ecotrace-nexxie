{
  "name": "eco-truck",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently -n backend,frontend \"cd backend && ./.venv/bin/python -m uvicorn api:app --reload --host 0.0.0.0 --port 8000\" \"npm --prefix frontend run dev\"",
    "dev": "npm run start",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "backend": "cd backend && ./.venv/bin/python -m uvicorn api:app --reload --host 0.0.0.0 --port 8000",
    "frontend": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
